{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drstrain-blog",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": true },
  "vars": {
    "EMAIL_FROM": "noreply@sso.drstra.in",
    "EMAIL_TO": "phvietan@gmail.com",
    "SITE_URL": "https://blog.drstra.in",
    "SITE_TITLE": "DrStrain's blog",
    "SITE_DESCRIPTION": "My information security journey. Research, write-ups, and notes from the field.",
    "OAUTH_ISSUER": "https://sso.drstra.in",
    "OAUTH_CLIENT_ID": "configure-blog-client-id",
    "OAUTH_REDIRECT_URI": "https://blog.drstra.in/oauth2/callback",
    "ADMIN_SUBS": ""
  },
  "d1_databases": [{ "binding": "DB", "database_name": "drstrain-blog", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "drstrain-blog" }],
  "send_email": [{ "name": "EMAIL" }],
  "triggers": { "crons": ["*/5 * * * *"] }
}
